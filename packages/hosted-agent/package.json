{
  "name": "@pcc/hosted-agent",
  "version": "0.1.0",
  "private": true,
  "description": "PCC's own hosted agent (ADK item 14): the hosted runtime of the agent pack. It acts as the user, never as PCC.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "@pcc/agent-runtime": "workspace:*",
    "better-sqlite3": "^11.8.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  }
}
