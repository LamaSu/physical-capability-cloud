{
  "name": "@pcc/orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "Intra-kernel instrument choreography — sequences steps across multiple instruments within a shop kernel",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@pcc/spec": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^1.6.0"
  }
}
