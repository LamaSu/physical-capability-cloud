{
  "name": "@pcc/kernel",
  "version": "0.1.0",
  "private": true,
  "description": "Shop Kernel — the boundary of trust for a physical site",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./evidence-storage": {
      "types": "./dist/evidence-storage.d.ts",
      "import": "./dist/evidence-storage.js",
      "default": "./dist/evidence-storage.js"
    },
    "./storacha-storage": {
      "types": "./dist/storacha-storage.d.ts",
      "import": "./dist/storacha-storage.js",
      "default": "./dist/storacha-storage.js"
    },
    "./evidence-storage-factory": {
      "types": "./dist/evidence-storage-factory.d.ts",
      "import": "./dist/evidence-storage-factory.js",
      "default": "./dist/evidence-storage-factory.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.0",
    "@helia/unixfs": "^7.0.4",
    "@lit-protocol/constants": "^6",
    "@lit-protocol/lit-node-client": "^6",
    "@lit-protocol/types": "^6",
    "@pcc/spec": "workspace:*",
    "@storacha/client": "^2.1.2",
    "better-sqlite3": "^11.0.0",
    "fastify": "^4.28.0",
    "helia": "^6.0.21",
    "multiformats": "^13.4.2",
    "nanoid": "^5.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "tsx": "^4.11.0",
    "vitest": "^1.6.0"
  }
}
