{
  "name": "@pcc/hamilton",
  "version": "0.1.0",
  "private": false,
  "description": "Hamilton ML Prep configuration helpers for PCC operators — generate KERNEL_CONFIG, validate options, register liquid-handling capabilities",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "examples"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "pcc",
    "physical-capability-cloud",
    "hamilton",
    "microlab-prep",
    "liquid-handler",
    "robotics",
    "lab-automation"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/LamaSu/physical-capability-cloud.git",
    "directory": "packages/hamilton"
  },
  "homepage": "https://capability.network",
  "dependencies": {},
  "devDependencies": {
    "vitest": "^1.6.0"
  }
}
