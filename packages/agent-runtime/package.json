{
  "name": "@pcc/agent-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Agent runtime — base framework with wallet, messaging, and tool-use",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@pcc/a2a": "workspace:*",
    "@pcc/spec": "workspace:*",
    "@scure/bip32": "^2.0.1",
    "@scure/bip39": "^2.0.1",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "1",
    "bs58": "4",
    "tweetnacl": "^1.0.3",
    "viem": "^2.21.0"
  },
  "peerDependencies": {
    "@pcc/bundler": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@pcc/bundler": { "optional": true }
  },
  "devDependencies": {
    "@pcc/bundler": "workspace:*",
    "vitest": "^1.6.0"
  }
}
