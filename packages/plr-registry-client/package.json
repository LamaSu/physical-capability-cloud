{
  "name": "@pcc/plr-registry-client",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript client + CLI for PLRBackendRegistry — read/write the on-chain PyLabRobot backend-author registry from off-chain code",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "pcc-plr-register": "dist/cli/register.js",
    "pcc-plr-toggle": "dist/cli/toggle.js",
    "pcc-plr-status": "dist/cli/status.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@noble/hashes": "^1.7.0",
    "@pcc/spec": "workspace:*",
    "viem": "^2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
