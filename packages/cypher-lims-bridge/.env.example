# Cypher Bio LIMS bridge configuration.
#
# Issued via Cypher Bio settings UI. The cyp_lims_* prefix denotes a
# LIMS-scoped key — it can read /api/lims/* and /api/federation/services/public,
# but cannot hit /api/docs/openapi.json or admin routes (returns 403).
CYPHER_API_KEY=cyp_lims_<your_key_here>

# Cypher API base. /backend is the CloudFront prefix that maps to the Express app.
# Final URL pattern: https://cypherbio.ai/backend/api/<resource>.
CYPHER_BASE_URL=https://cypherbio.ai/backend

# Polling cadence for new LIMS requests, in milliseconds.
# 30000 (30s) is a courteous default; tune higher for low-volume operators.
CYPHER_POLL_INTERVAL_MS=30000

# Optional: tag every record-work / advance-step call with this operator ID
# so PCC and Cypher both attribute the work to the same identity.
CYPHER_OPERATOR_ID=
