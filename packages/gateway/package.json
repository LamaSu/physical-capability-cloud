{
  "name": "@pcc/gateway",
  "version": "0.1.0",
  "private": true,
  "description": "HTTP/SSE gateway bridging the dashboard to the PCC agent network",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/static": "^7.0.4",
    "@fastify/websocket": "^10.0.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.214.0",
    "@opentelemetry/resources": "^2.6.0",
    "@opentelemetry/sdk-node": "^0.214.0",
    "@opentelemetry/sdk-trace-node": "^2.6.1",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@pcc/a2a": "workspace:*",
    "@pcc/agent-broker": "workspace:*",
    "@pcc/agent-kernel": "workspace:*",
    "@pcc/agent-runtime": "workspace:*",
    "@pcc/agent-user": "workspace:*",
    "@pcc/bundler": "workspace:*",
    "@pcc/contract-builder": "workspace:*",
    "@pcc/contracts": "workspace:*",
    "@pcc/demand-intel": "workspace:*",
    "@pcc/dht": "workspace:*",
    "@pcc/evidence-embeddings": "workspace:*",
    "@pcc/kernel": "workspace:*",
    "@pcc/orchestrator": "workspace:*",
    "@pcc/orchestrator-sdk": "workspace:*",
    "@pcc/payments": "workspace:*",
    "@pcc/template-data-product": "workspace:*",
    "@pcc/template-physical-operator": "workspace:*",
    "@pcc/scheduler": "workspace:*",
    "@pcc/spec": "workspace:*",
    "@pcc/store": "workspace:*",
    "@pcc/tool-index": "workspace:*",
    "@pcc/touchstone": "workspace:*",
    "@pcc/verifier": "workspace:*",
    "@sentry/node": "^10.45.0",
    "fastify": "^4.26.0",
    "posthog-node": "^4.2.0",
    "tweetnacl": "^1.0.3",
    "uuid": "^9.0.0",
    "viem": "^2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/uuid": "^9.0.0",
    "tsx": "^4.11.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
