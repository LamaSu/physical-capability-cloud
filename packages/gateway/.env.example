# PCC Gateway — Environment Variables
# Copy to .env and customize

# ── Network ──────────────────────────────────────────
# Chain to connect to: localhost | base-sepolia | base
PCC_NETWORK=base-sepolia

# JSON-RPC endpoint (defaults per network if omitted)
# PCC_RPC_URL=https://sepolia.base.org

# ── Contracts ────────────────────────────────────────
# Treasury address for escrow payments
# PCC_TREASURY_ADDRESS=0x0000000000000000000000000000000000000001

# ── x402 Payments ────────────────────────────────────
# Enable x402 payment gating on protected routes (default: false)
PCC_X402_ENABLED=false

# x402 facilitator service URL
# PCC_X402_FACILITATOR_URL=http://localhost:4020

# ── Lit Protocol ──────────────────────────────────────
# Use real Lit Protocol encryption (datil-test network) instead of mock
# Requires network access to Lit nodes. Default: false (mock with local AES-256-GCM)
# LIT_PROTOCOL_REAL=false

# ── Server ───────────────────────────────────────────
# Gateway HTTP port (default: 3200)
# PORT=3200

# Node environment
NODE_ENV=development

# ── MCP Apps (generative-UI views) ───────────────────
# Unique https ORIGIN the MCP App dashboard view is served under. It becomes the
# view's _meta.ui.domain, which a compliant host (Claude Desktop / ChatGPT Apps)
# uses to give the view its OWN iframe origin — isolating its browser storage
# from every other view (D14: prevents cross-view credential theft). MUST be a
# bare https origin (no credentials/path/query/fragment) and is REQUIRED in
# production (the gateway fails to boot without it); dev/test falls back to the
# reserved placeholder https://pcc-mcp-app.invalid.
# PCC_MCP_APP_DOMAIN=https://pcc-mcp-app.example

# ── Carrier (EasyPost) — print-and-mail physical-provenance oracle ──
# Buys real postage labels upstream (before a human ever touches the
# envelope) so the tracking number is issued by the carrier, not PCC. Unset =
# mock mode (label/tracking fabricated locally, source.simulated:true on any
# resulting evidence — no external calls, gateway still boots and the route
# contract is testable).
# Self-serve signup: https://www.easypost.com (instant test key, no sales gate).
# EASYPOST_API_KEY=EZAKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# Webhook secret from the EasyPost dashboard (Webhooks -> your endpoint ->
# secret). Required to verify the X-Hmac-Signature header on inbound tracking
# webhooks; POST /api/carrier/webhook/easypost fails closed (503) without it —
# never processes an unverified webhook.
# EASYPOST_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Sentry Distributed Tracing ───────────────────────
# DSN for end-to-end trace waterfalls (org: pccp, project: javascript-react)
# SENTRY_DSN=https://82659bf7715d419a7eb1294c0b810ca8@o4511078592872448.ingest.us.sentry.io/4511078631342080

# ── Gasless / ERC-4337 Smart Accounts (bundler + paymaster) ──────────
# PCC upgrades EOA signers into ERC-4337 smart accounts so agents don't need to
# hold ETH for gas. Configure ONE provider below. Resolved by
# packages/gateway/src/config/bundler-config.ts (precedence: ZeroDev → generic
# PCC_* → legacy BUNDLER_URL → Coinbase CDP). All optional — unset = disabled.
#
# Option 1 — ZeroDev (recommended for passkey / sponsored gas). Create a project
# at https://dashboard.zerodev.app, add a gas policy, then paste the exact
# Bundler + Paymaster RPC URLs it shows you:
# ZERODEV_BUNDLER_URL=https://rpc.zerodev.app/api/v3/<projectId>/chain/84532
# ZERODEV_PAYMASTER_URL=https://rpc.zerodev.app/api/v3/<projectId>/chain/84532
#   …or just set the project id and let the gateway build the v3 URL:
# ZERODEV_PROJECT_ID=<your-zerodev-project-id>
#
# Option 2 — Generic bundler/paymaster (Pimlico, Alchemy, Stackup, self-hosted):
# PCC_BUNDLER_URL=https://api.pimlico.io/v2/base-sepolia/rpc?apikey=<key>
# PCC_PAYMASTER_URL=https://api.pimlico.io/v2/base-sepolia/rpc?apikey=<key>
#
# Option 3 — Coinbase CDP (one URL serves bundler + paymaster):
# CDP_API_KEY=<cdp-api-key>              # or COINBASE_PAYMASTER_URL=<full-url>
#
# Chain for the bundler (base | base-sepolia). Defaults to PCC_NETWORK.
# BUNDLER_CHAIN=base-sepolia
#
# Gateway operational EOA — funds/deploys smart accounts, signs batch settlement.
# Needs a little Base-Sepolia ETH ONLY for non-sponsored txs.
# PCC_GATEWAY_PRIVATE_KEY=0x...
