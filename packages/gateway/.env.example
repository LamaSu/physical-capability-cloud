# PCC Gateway — Environment Variables
# Copy to .env and customize

# ── Network ──────────────────────────────────────────
# Chain to connect to: localhost | base-sepolia | base
PCC_NETWORK=base-sepolia

# JSON-RPC endpoint (defaults per network if omitted)
# PCC_RPC_URL=https://sepolia.base.org

# ── Contracts ────────────────────────────────────────
# Treasury address for escrow payments
# PCC_TREASURY_ADDRESS=0x0000000000000000000000000000000000000001

# ── x402 Payments ────────────────────────────────────
# Enable x402 payment gating on protected routes (default: false)
PCC_X402_ENABLED=false

# x402 facilitator service URL
# PCC_X402_FACILITATOR_URL=http://localhost:4020

# ── Server ───────────────────────────────────────────
# Gateway HTTP port (default: 3200)
# PORT=3200

# Node environment
NODE_ENV=development
