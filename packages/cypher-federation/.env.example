# Cypher Bio federation API key. NOTE: cyp_lims_* keys are LIMS-scoped only and
# will return 403 on /api/federation/instances/register. Federation registration
# requires an admin-scoped key (cyp_admin_*) or for Cypher to grant peering to
# your LIMS-scoped key directly. Until peering is granted, scripts/register-with-cypher.ts
# will fail at register time and instead print the manifest body so you can
# email it to Cypher.
CYPHER_FEDERATION_API_KEY=cyp_admin_<your_key_here>
CYPHER_BASE_URL=https://cypherbio.ai/backend

# PCC gateway URL (used to fetch capability list when building the manifest)
PCC_GATEWAY_URL=https://capability.network

# PCC's federation identity, advertised to Cypher at register time.
PCC_FEDERATION_INSTANCE_ID=pcc
PCC_FEDERATION_NAME=PCC
PCC_FEDERATION_BASE_URL=https://capability.network/cypher/federation
PCC_FEDERATION_CONTACT_EMAIL=
