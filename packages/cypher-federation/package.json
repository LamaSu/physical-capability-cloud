{
  "name": "@pcc/cypher-federation",
  "version": "0.1.0",
  "private": true,
  "description": "PCC ↔ Cypher Bio federation peer. Registers PCC as a federation instance, advertises PCC capabilities as Cypher services, accepts inbound orders, translates them into PCC A2A intents + escrow flows, and reports settlement back to Cypher.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "register": "tsx scripts/register-with-cypher.ts"
  },
  "dependencies": {
    "express": "^4.19.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "supertest": "^6.3.4",
    "@types/supertest": "^6.0.2",
    "tsx": "^4.11.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
