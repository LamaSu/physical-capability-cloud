[Unit]
Description=pcc-node -- Physical Capability Cloud operator node
Documentation=https://capability.network
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# -I (isolated mode): ignore PYTHONPATH and user site-packages, so nothing on them can run before the
# in-process spawn guard installs. `-m pcc_node` routes through the guarded entry (pcc_node._entry.run),
# which installs the guard before importing the CLI.
ExecStart=/usr/bin/python3 -I -m pcc_node start
Restart=on-failure
RestartSec=5

# === Hard spawn allowlist (steward ruling 10/03) ========================================
# The OS -- not the in-process Python hook -- guarantees that pcc-node can execute only its pinned
# device utilities. NoExecPaths=/ denies execute (execve and mmap PROT_EXEC) everywhere; ExecPaths=
# re-allows ONLY the Python interpreter and its library directories (so the C extensions load) and
# the pinned device utilities. A shell (/bin/sh, /bin/bash) is therefore un-executable.
#
# ExecPaths MUST be resolved for this host: the stdlib lives in a versioned directory (e.g.
# /usr/lib/python3.12) and the utilities differ by distro. deploy/install.sh computes the correct
# list and substitutes it below. The @EXEC_PATHS@ placeholder is intentionally non-functional so an
# un-processed unit fails fast rather than silently running without the libraries it needs.
NoExecPaths=/
ExecPaths=@EXEC_PATHS@
NoNewPrivileges=yes

# The device utilities need no elevated privileges.
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
