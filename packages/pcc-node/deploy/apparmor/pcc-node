# AppArmor profile for pcc-node -- Layer 1, the HARD exec allowlist (steward ruling 10/03, verdict 105n).
#
# This is the mechanism that actually guarantees "pcc-node executes only its pinned device utilities".
# AppArmor has SEPARATE permissions for execute-as-program (x) and executable memory-map (m). That is
# the control the in-process Landlock layer (L2) lacks: Landlock must grant the ELF loader EXECUTE so
# dynamically-linked utilities can run, and its execute right does not govern mmap, so
# `execve(ld.so, [ld, /bin/sh])` runs a shell (the loader maps it). Here the loader gets map-only (mr
# via abstractions/base) and is explicitly denied execute-as-program, so that gadget is refused while
# the utilities still load their libraries. AppArmor denies by default, so only the lines below execute.
#
# Load it, then run pcc-node under it (the shipped unit sets AppArmorProfile=pcc-node):
#   apparmor_parser -r -W deploy/apparmor/pcc-node
#   aa-exec -p pcc-node -- python3 -I -m pcc_node start --yes     # (or via the systemd unit)
# VERIFY on the host before relying on it: aa-status shows it enforced; a shell is refused
#   (aa-exec -p pcc-node -- /bin/sh -c true  ->  Permission denied); each pinned utility runs.
#include <tunables/global>

profile pcc-node flags=(attach_disconnected) {
  #include <abstractions/base>

  # The interpreter and its libraries (ix = run under this same profile; mr = map read/exec the libs).
  /usr/bin/python3* ix,
  /usr/local/bin/python3* ix,
  /usr/lib/python3*/** mr,
  /usr/lib64/python3*/** mr,
  /usr/local/lib/python3*/** mr,

  # The pinned device utilities -- and, by default-deny, only these -- may be executed.
  /{usr/,}bin/dd ix,
  /{usr/,}bin/ffmpeg ix,
  /{usr/,}bin/journalctl ix,
  /{usr/,}bin/v4l2-ctl ix,
  /{usr/,}sbin/arp ix,
  /{usr/,}sbin/sysctl ix,

  # Close the loader gadget (verdict 105n): abstractions/base grants the dynamic loader `mr` (map), so
  # the interpreter and the utilities above load normally -- but executing the loader AS A PROGRAM
  # (`execve(ld.so, [ld, <any ELF>])`) would otherwise run an un-pinned binary. Deny execute on it;
  # the map (m) stays, so this costs nothing and shuts the one hole Landlock cannot.
  deny /{usr/,}lib{,32,64}/**/ld-*.so* x,
  deny /{usr/,}lib/@{multiarch}/ld-*.so* x,

  # Explicit: shells are denied (default-deny already refuses anything unlisted; this documents intent).
  deny /{usr/,}bin/sh x,
  deny /{usr/,}bin/bash x,
  deny /{usr/,}bin/dash x,

  # pcc-node's own config, key/state, and network. /var/lib/pcc-node is the unit's StateDirectory (where
  # HOME and keys.json point); @{HOME}/.pcc-node covers the aa-exec case where HOME is a real home.
  /etc/pcc-node/** r,
  /var/lib/pcc-node/** rwk,
  owner @{HOME}/.pcc-node/** rwk,

  # Camera capture (verdict 105n MEDIUM3): the pinned utilities v4l2-ctl/ffmpeg/dd run under this
  # profile (ix), so they inherit these grants -- the video devices and the frame scratch file that
  # pcc_node/camera.py reads and writes. Without them the profile denies real capture operations.
  /dev/video[0-9]* rw,
  /tmp/pcc_frame.jpg rwk,

  network inet stream,
  network inet6 stream,
}
