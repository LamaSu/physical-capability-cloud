{
  "name": "@pcc/dht",
  "version": "0.1.0",
  "private": true,
  "description": "Distributed capability discovery — WebSocket gossip DHT for the Physical Capability Cloud",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@pcc/spec": "workspace:*",
    "@pcc/a2a": "workspace:*",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "vitest": "^1.6.0"
  }
}
