{
  "name": "@pcc/agent-evaluator",
  "version": "0.1.0",
  "private": true,
  "description": "Evaluator Agent — third-party quality assessment for milestone evidence, issues attestation VCs",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@pcc/spec": "workspace:*",
    "@pcc/a2a": "workspace:*",
    "@pcc/agent-runtime": "workspace:*",
    "@pcc/identity-8004": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^3.0.0",
    "typescript": "^5.4.0"
  }
}
