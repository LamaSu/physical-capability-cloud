{
  "name": "@pcc/kernel-omniverse-sim",
  "version": "0.1.0",
  "private": true,
  "description": "PCC kernel for pre-flight digital-twin attestation via NVIDIA Omniverse Kit (headless). Runs a MADSci workflow in simulation, returns a signed pass/fail attestation. Binds to PCC escrow as a pre-execution milestone.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@pcc/adapter-madsci": "workspace:*",
    "@pcc/kernel-sdk": "workspace:*",
    "@pcc/spec": "workspace:*",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
