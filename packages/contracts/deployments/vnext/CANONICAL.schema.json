{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PCC V-next canonical deployment record",
  "description": "Schema for deployments/vnext/<network>/CANONICAL.json written by DeployVNextSettlement.s.sol. PROVISIONAL and DRYRUN records are out of scope. Readers must also check the record path: chainId must match the directory slug (base = 8453, base-sepolia = 84532, anvil = 31337, otherwise chain-<chainId>). A missing record or a chainId/path mismatch fails closed. A scheduleTestnetOnly record is a short-window demo deployment and must never settle real value.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "canonical": { "type": "boolean", "const": true },
    "doNotPin": { "type": "boolean", "const": false },
    "mode": { "type": "string", "const": "CANONICAL" },
    "label": { "type": "string", "const": "" },
    "broadcast": { "type": "boolean", "const": true },
    "provisionalTagOnChain": { "type": "string" },
    "factory": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "implementation": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "library": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "implementationCodehash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "libraryCodehash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "primaryAttester": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "escalationAttester": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "usdc": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "eas": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "o5SchemaUid": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "o5TypeHash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "primaryCohortId": { "type": "integer", "minimum": 0 },
    "escalationCohortId": { "type": "integer", "minimum": 0 },
    "signerSetIntersection": { "type": "integer", "minimum": 0 },
    "quorumFloor": { "type": "integer", "minimum": 0 },
    "signerSetsFullyDisjoint": { "type": "boolean" },
    "signerOverlapExplicitlyAllowed": { "type": "boolean" },
    "primaryEnabled": { "type": "boolean" },
    "escalationEnabled": { "type": "boolean" },
    "primaryDisabledAt": { "type": "integer", "minimum": 0 },
    "escalationDisabledAt": { "type": "integer", "minimum": 0 },
    "routeDiversityRule": { "type": "string" },
    "chainId": { "type": "integer", "minimum": 1 },
    "specVersion": { "type": "integer", "minimum": 0 },
    "blockNumber": { "type": "integer", "minimum": 0 },
    "scheduleId": { "type": "string" },
    "scheduleTestnetOnly": { "type": "boolean" },
    "challengeWindowSec": { "type": "integer", "minimum": 0 },
    "appealWindowSec": { "type": "integer", "minimum": 0 },
    "backupWindowSec": { "type": "integer", "minimum": 0 },
    "emergencyReviewWindowSec": { "type": "integer", "minimum": 0 },
    "minReclaimDelaySec": { "type": "integer", "minimum": 0 },
    "maxReclaimDelaySec": { "type": "integer", "minimum": 0 },
    "solc": { "type": "string" },
    "optimizer": { "type": "string" },
    "reverify": { "type": "string" },
    "digest": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" }
  },
  "required": [
    "canonical",
    "doNotPin",
    "mode",
    "label",
    "broadcast",
    "provisionalTagOnChain",
    "factory",
    "implementation",
    "library",
    "implementationCodehash",
    "libraryCodehash",
    "primaryAttester",
    "escalationAttester",
    "usdc",
    "eas",
    "o5SchemaUid",
    "o5TypeHash",
    "primaryCohortId",
    "escalationCohortId",
    "signerSetIntersection",
    "quorumFloor",
    "signerSetsFullyDisjoint",
    "signerOverlapExplicitlyAllowed",
    "primaryEnabled",
    "escalationEnabled",
    "primaryDisabledAt",
    "escalationDisabledAt",
    "routeDiversityRule",
    "chainId",
    "specVersion",
    "blockNumber",
    "scheduleId",
    "scheduleTestnetOnly",
    "challengeWindowSec",
    "appealWindowSec",
    "backupWindowSec",
    "emergencyReviewWindowSec",
    "minReclaimDelaySec",
    "maxReclaimDelaySec",
    "solc",
    "optimizer",
    "reverify",
    "digest"
  ]
}
