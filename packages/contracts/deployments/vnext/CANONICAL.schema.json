{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PCC V-next canonical deployment record",
  "description": "Schema for deployments/vnext/<network>/CANONICAL.json written by DeployVNextSettlement.s.sol. PROVISIONAL and DRYRUN records are out of scope. Readers must also check the record path: chainId must match the directory slug (base = 8453, base-sepolia = 84532, anvil = 31337, otherwise chain-<chainId>). A missing record or a chainId/path mismatch fails closed. A scheduleTestnetOnly record is a short-window demo deployment and must never settle real value.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "canonical": { "type": "boolean", "const": true },
    "doNotPin": { "type": "boolean", "const": false },
    "mode": { "type": "string", "const": "CANONICAL" },
    "label": { "type": "string", "const": "" },
    "broadcast": { "type": "boolean", "const": true },
    "provisionalTagOnChain": { "type": "string" },
    "factory": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$", "minLength": 42, "maxLength": 42 },
    "implementation": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$", "minLength": 42, "maxLength": 42 },
    "library": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$", "minLength": 42, "maxLength": 42 },
    "implementationCodehash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$", "minLength": 66, "maxLength": 66 },
    "libraryCodehash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$", "minLength": 66, "maxLength": 66 },
    "primaryAttester": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$", "minLength": 42, "maxLength": 42 },
    "escalationAttester": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$", "minLength": 42, "maxLength": 42 },
    "usdc": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$", "minLength": 42, "maxLength": 42 },
    "eas": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$", "minLength": 42, "maxLength": 42 },
    "o5SchemaUid": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$", "minLength": 66, "maxLength": 66 },
    "o5TypeHash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$", "minLength": 66, "maxLength": 66 },
    "primaryCohortId": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "escalationCohortId": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "signerSetIntersection": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "quorumFloor": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "signerSetsFullyDisjoint": { "type": "boolean" },
    "signerOverlapExplicitlyAllowed": { "type": "boolean" },
    "primaryEnabled": { "type": "boolean" },
    "escalationEnabled": { "type": "boolean" },
    "primaryDisabledAt": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "escalationDisabledAt": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "routeDiversityRule": { "type": "string" },
    "chainId": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "specVersion": { "type": "integer", "const": 2 },
    "blockNumber": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "scheduleId": { "type": "string", "enum": ["vnext-mainnet-v1", "vnext-testnet-short-v1"] },
    "scheduleTestnetOnly": { "type": "boolean" },
    "challengeWindowSec": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "appealWindowSec": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "backupWindowSec": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "emergencyReviewWindowSec": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "minReclaimDelaySec": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "maxReclaimDelaySec": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "solc": { "type": "string" },
    "optimizer": { "type": "string" },
    "reverify": { "type": "string" },
    "digest": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$", "minLength": 66, "maxLength": 66 }
  },
  "allOf": [
    {
      "if": { "properties": { "scheduleTestnetOnly": { "const": true } } },
      "then": { "properties": { "chainId": { "enum": [84532, 31337] } } }
    }
  ],
  "oneOf": [
    {
      "properties": {
        "scheduleId": { "const": "vnext-testnet-short-v1" },
        "scheduleTestnetOnly": { "const": true },
        "challengeWindowSec": { "const": 600 },
        "appealWindowSec": { "const": 1500 },
        "backupWindowSec": { "const": 600 },
        "emergencyReviewWindowSec": { "const": 1500 },
        "minReclaimDelaySec": { "const": 4500 },
        "maxReclaimDelaySec": { "const": 31536000 }
      }
    },
    {
      "properties": {
        "scheduleId": { "const": "vnext-mainnet-v1" },
        "scheduleTestnetOnly": { "const": false },
        "challengeWindowSec": { "const": 172800 },
        "appealWindowSec": { "const": 432000 },
        "backupWindowSec": { "const": 172800 },
        "emergencyReviewWindowSec": { "const": 432000 },
        "minReclaimDelaySec": { "const": 864000 },
        "maxReclaimDelaySec": { "const": 31536000 }
      }
    }
  ],
  "required": [
    "canonical",
    "doNotPin",
    "mode",
    "label",
    "broadcast",
    "provisionalTagOnChain",
    "factory",
    "implementation",
    "library",
    "implementationCodehash",
    "libraryCodehash",
    "primaryAttester",
    "escalationAttester",
    "usdc",
    "eas",
    "o5SchemaUid",
    "o5TypeHash",
    "primaryCohortId",
    "escalationCohortId",
    "signerSetIntersection",
    "quorumFloor",
    "signerSetsFullyDisjoint",
    "signerOverlapExplicitlyAllowed",
    "primaryEnabled",
    "escalationEnabled",
    "primaryDisabledAt",
    "escalationDisabledAt",
    "routeDiversityRule",
    "chainId",
    "specVersion",
    "blockNumber",
    "scheduleId",
    "scheduleTestnetOnly",
    "challengeWindowSec",
    "appealWindowSec",
    "backupWindowSec",
    "emergencyReviewWindowSec",
    "minReclaimDelaySec",
    "maxReclaimDelaySec",
    "solc",
    "optimizer",
    "reverify",
    "digest"
  ]
}
