# Deployment configuration for @pcc/contracts
#
# Copy to .env and fill in values:
#   cp .env.example .env

# Required: deployer wallet private key (with 0x prefix)
DEPLOYER_PRIVATE_KEY=0x...your_private_key...

# Optional: RPC endpoint (default: Base Sepolia)
RPC_URL=https://sepolia.base.org

# Optional: arbiter address (defaults to deployer)
# ARBITER_ADDRESS=0x...

# Optional: BaseScan API key for contract verification
# Get one at https://basescan.org/myapikey
ETHERSCAN_API_KEY=your_basescan_api_key
