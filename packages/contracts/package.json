{
  "name": "@pcc/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Solidity contracts + TypeScript ABI exports for Physical Capability Cloud",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./abi": {
      "types": "./dist/abi/index.d.ts",
      "import": "./dist/abi/index.js",
      "default": "./dist/abi/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "forge:build": "forge build",
    "forge:test": "forge test -vvv",
    "forge:deploy:local": "forge script script/DeployLocal.s.sol:DeployLocalScript --rpc-url http://127.0.0.1:8545 --broadcast -vvvv",
    "forge:deploy:base-sepolia": "bash script/deploy.sh"
  },
  "dependencies": {
    "@pcc/spec": "workspace:*",
    "viem": "^2"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
