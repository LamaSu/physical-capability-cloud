{
  "name": "@pcc/a2a-signing",
  "version": "0.1.0",
  "private": true,
  "description": "A2A v1.0 Agent Card signing — JWS (RFC 7515) over JCS-canonicalized JSON (RFC 8785) using ES256 (P-256)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "canonicalize": "^2.0.0",
    "jose": "^5.6.0"
  },
  "devDependencies": {
    "vitest": "^1.6.0"
  }
}
