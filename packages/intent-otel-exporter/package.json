{
  "name": "@pcc/intent-otel-exporter",
  "version": "0.1.0",
  "private": true,
  "description": "OpenTelemetry SpanExporter + SpanProcessor that detects intent-shaped spans (tool.*, mcp.*, agent.*, http.request with gen_ai semconv) and forwards DemandEnvelopes to PCC's /api/intents/ingest. Phase 2.3 of the intent-network-interception roadmap.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^1.30.0",
    "@opentelemetry/sdk-trace-base": "^1.30.0",
    "@pcc/spec": "workspace:*"
  },
  "devDependencies": {
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
