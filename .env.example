# ── Gateway Server ───────────────────────────────────────────────────────────
# Bind address or hostname of the gateway's HTTP listener ONLY (trimmed).
# Unset or blank means 0.0.0.0, every IPv4 interface.
# Exception: the default evidence store (Helia, used for every EVIDENCE_STORAGE
# value except storacha) opens its own libp2p listeners on all interfaces, with
# UPnP port mapping, the first time an evidence-archive or IPFS route, or a job
# completion, runs. PCC_LISTEN_HOST does not cover those listeners.
# PCC_LISTEN_HOST=0.0.0.0
# Demo seed: exact false disables, true forces; main store defaults on outside production
# Legacy request/batch demos stay enabled by default in every environment
# PCC_SEED_DATA=false

# ── Local Job Dispatch (self-hosted labs) ────────────────────────────────────
# With NODE_ENV=production (the Docker image's default), job submit is
# queue-only unless this is exactly false. Outside production, only an exact
# true makes it queue-only. Queued jobs wait for a remote node (pcc-node).
# Enable local dispatch only on a gateway that untrusted callers can't reach.
# PCC_JOB_SUBMIT_QUEUE_ONLY=false
# Local dispatch also needs an explicit kernel config: inline JSON, or a path
# to a JSON file (KERNEL_CONFIG wins if both are set). Its kernelId must not be
# the placeholder kernel_dev_001, and the job's kernel must be that kernelId.
# KERNEL_CONFIG='{"kernelId":"kernel_my_lab", ...}'
# KERNEL_CONFIG_FILE=/app/data/kernel-config.json
# Names the generated mock config's kernel, and seeds the kernel id that the
# setup routes use for a config that names none. It never enables local dispatch.
# KERNEL_ID=kernel_dev_001
# See docs/DEPLOY.md, "Local job dispatch on the production image".

# ── Oracle Verification (UMA OOv3 + Chainlink Functions) ──────────────────────
#
# Default: ORACLE_MOCK=true (in-process simulation, no on-chain calls)
# Set ORACLE_MOCK=false to enable live on-chain verification.
#
# Both UMA and Chainlink require Base Sepolia ETH in the deployer wallet.
# Get testnet ETH: https://www.coinbase.com/faucets/base-ethereum-sepolia-faucet

# Deployer / asserter wallet private key (0x-prefixed)
DEPLOYER_PRIVATE_KEY=0x...

# UMA Optimistic Oracle v3 — Base Sepolia
UMA_OOV3_ADDRESS=0xFd9e2642a170aDD10F53Ee14a93FcF2F31924944
UMA_BOND_TOKEN=0x036CbD53842c5426634e7929541eC2318f3dCF7e
UMA_BOND_AMOUNT=500000000
UMA_LIVENESS_SECONDS=7200

# Alternatively set UMA_ASSERTER_PRIVATE_KEY separately from deploy key:
# UMA_ASSERTER_PRIVATE_KEY=0x...

# Chainlink Functions — Base Sepolia
CHAINLINK_ROUTER=0xf9B8fc078197181C841c296C876945aaa425B278
CHAINLINK_DON_ID=fun-base-sepolia-1
CHAINLINK_SUB_ID=                          # Your funded subscription ID
CHAINLINK_CONSUMER_ADDRESS=               # After deploying ChainlinkEvidenceVerifier

# Base Sepolia RPC
BASE_RPC_URL=https://sepolia.base.org
CHAIN_ID=84532

# Oracle mode: set to false for live on-chain verification
ORACLE_MOCK=true

# Minimum score threshold for passing (0.0 - 1.0)
ORACLE_MIN_SCORE=0.6

# ── ERC-8004 Identity Registry (Daydreams canonical singleton) ──────────────
# The READ path (.well-known/agent-registration.json) is wired by default
# to the Daydreams Identity Registry singleton on Base Sepolia:
#   0x8004A818BFB912233c491871b3d84c89A494BD9e
# The WRITE path (write at /api/auth/provision) is OPT-IN via
# PCC_GATEWAY_PRIVATE_KEY. Without a key, provision still succeeds — the
# on-chain identity stays onchain_status='pending' until a key is added
# (the retry sweeper picks it up).
#
# To enable on-chain identity write at provision time:
#   PCC_GATEWAY_PRIVATE_KEY=0x...                 # 32-byte hex, gas-funded on Base Sepolia
#   PCC_GATEWAY_URL=https://capability.network    # public URL of this gateway
# PCC_PUBLIC_URL is the origin sign-in binds to; local sign-in runs set it to the origin they sign (the dashboard dev server or an e2e posting verify).
#
# To override the registry (e.g. for a forked deployment):
#   IDENTITY_REGISTRY_ADDRESS=0x...
#   IDENTITY_REGISTRY_CHAIN_ID=84532
#   BASE_SEPOLIA_RPC=https://sepolia.base.org
#
# To disable the retry sweeper without un-setting the key:
#   ERC8004_SWEEPER_DISABLED=true

# ── Starknet ZK Proof Anchoring ───────────────────────────────────────────────
# STARKNET_ACCOUNT_ADDRESS=0x...
# STARKNET_PRIVATE_KEY=0x...
# STARKNET_NODE_URL=https://starknet-goerli.infura.io/v3/...

# ── Evidence Storage ──────────────────────────────────────────────────────────
# EVIDENCE_STORAGE=storacha           # Use Storacha w3up instead of Helia
# STORACHA_PROOF=...                  # base64 delegation proof
# STORACHA_SPACE_DID=did:key:...      # Storacha space DID

# ── CID Blob Storage (generic binary artifacts) ───────────────────────────────
# Shares EVIDENCE_STORAGE for backend selection (local/helia/storacha).
# See docs/CID_STORAGE.md for the full surface (/api/storage POST/GET/DELETE).
# PCC_BLOB_DIR=./data/blobs           # Local backend root
# STORAGE_MAX_UPLOAD_MB=100           # Per-request upload cap (MB)

# ── Lit Protocol Encryption ───────────────────────────────────────────────────
# LIT_PROTOCOL_REAL=true              # Use real Lit Protocol (datil-test network)
