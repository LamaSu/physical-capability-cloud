# ── Oracle Verification (UMA OOv3 + Chainlink Functions) ──────────────────────
#
# Default: ORACLE_MOCK=true (in-process simulation, no on-chain calls)
# Set ORACLE_MOCK=false to enable live on-chain verification.
#
# Both UMA and Chainlink require Base Sepolia ETH in the deployer wallet.
# Get testnet ETH: https://www.coinbase.com/faucets/base-ethereum-sepolia-faucet

# Deployer / asserter wallet private key (0x-prefixed)
DEPLOYER_PRIVATE_KEY=0x...

# UMA Optimistic Oracle v3 — Base Sepolia
UMA_OOV3_ADDRESS=0xFd9e2642a170aDD10F53Ee14a93FcF2F31924944
UMA_BOND_TOKEN=0x036CbD53842c5426634e7929541eC2318f3dCF7e
UMA_BOND_AMOUNT=500000000
UMA_LIVENESS_SECONDS=7200

# Alternatively set UMA_ASSERTER_PRIVATE_KEY separately from deploy key:
# UMA_ASSERTER_PRIVATE_KEY=0x...

# Chainlink Functions — Base Sepolia
CHAINLINK_ROUTER=0xf9B8fc078197181C841c296C876945aaa425B278
CHAINLINK_DON_ID=fun-base-sepolia-1
CHAINLINK_SUB_ID=                          # Your funded subscription ID
CHAINLINK_CONSUMER_ADDRESS=               # After deploying ChainlinkEvidenceVerifier

# Base Sepolia RPC
BASE_RPC_URL=https://sepolia.base.org
CHAIN_ID=84532

# Oracle mode: set to false for live on-chain verification
ORACLE_MOCK=true

# Minimum score threshold for passing (0.0 - 1.0)
ORACLE_MIN_SCORE=0.6

# ── Starknet ZK Proof Anchoring ───────────────────────────────────────────────
# STARKNET_ACCOUNT_ADDRESS=0x...
# STARKNET_PRIVATE_KEY=0x...
# STARKNET_NODE_URL=https://starknet-goerli.infura.io/v3/...

# ── Evidence Storage ──────────────────────────────────────────────────────────
# EVIDENCE_STORAGE=storacha           # Use Storacha w3up instead of Helia
# STORACHA_PROOF=...                  # base64 delegation proof
# STORACHA_SPACE_DID=did:key:...      # Storacha space DID

# ── Lit Protocol Encryption ───────────────────────────────────────────────────
# LIT_PROTOCOL_REAL=true              # Use real Lit Protocol (datil-test network)
