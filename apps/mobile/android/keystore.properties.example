# PCC Android upload-key signing config — TEMPLATE.
#
# Copy this file to `keystore.properties` (same dir) and fill in real values.
# The real keystore.properties is gitignored and must NEVER be committed.
#
# 1. Generate an UPLOAD keystore once (safeguard it forever — it is the identity
#    Google Play uses to accept your uploads; losing it blocks all future updates):
#
#      keytool -genkeypair -v \
#        -keystore pcc-upload.jks \
#        -alias pcc-upload \
#        -keyalg RSA -keysize 2048 -validity 10000 \
#        -storetype JKS
#
#    Answer the prompts (org, location) and set a strong store + key password.
#
# 2. Store pcc-upload.jks OUTSIDE the repo (it's gitignored anyway) and record
#    the passwords in a password manager. For CI, base64-encode the .jks and add
#    it plus the passwords as GitHub Actions secrets (see the android-build
#    workflow / the publish runbook).
#
# 3. Enroll in Google Play App Signing so Google holds the real app signing key
#    and this upload key only authorizes uploads — a lost upload key can then be
#    reset by Google (a lost *app signing* key cannot).

storeFile=/absolute/path/to/pcc-upload.jks
storePassword=CHANGE_ME
keyAlias=pcc-upload
keyPassword=CHANGE_ME
