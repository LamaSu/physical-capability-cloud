# ---------------------------------------------------------------------------
# PCC Dashboard — Environment Variables
# Copy this file to .env.local and fill in your values.
# All VITE_ prefixed vars are bundled into the client build (public).
# Never put secrets in VITE_ vars.
# ---------------------------------------------------------------------------

# PostHog — product analytics
# Get your project API key from https://app.posthog.com/project/settings
VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Google Analytics 4
# Get your measurement ID from Google Analytics > Admin > Data Streams
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry — error monitoring
# Get your DSN from https://sentry.io/settings/<org>/projects/<project>/keys/
VITE_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@o0.ingest.sentry.io/0

# Sentry source map upload (build-time only — NOT prefixed with VITE_)
# These are never bundled into the client. Used by @sentry/vite-plugin.
SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=pcc-dashboard
